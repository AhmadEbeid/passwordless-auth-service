# Copy to .env and adjust for local development.

# --- required ---
DATABASE_URL=postgres://authsvc:authsvc@localhost:5432/authsvc?sslmode=disable

# --- server ---
HTTP_PORT=8080
LOG_LEVEL=info
APP_ENV=development

# --- admin API ---
# Blank rejects every /admin/* request: the gate fails closed.
ADMIN_API_KEY=
ADMIN_ID=admin
# Comma-separated origins the admin dashboard is served from. Blank sends no
# CORS headers.
ADMIN_ALLOWED_ORIGINS=

# --- Google sign-in ---
# Blank rejects every Google ID token.
GOOGLE_CLIENT_ID=
# Signs the short-lived pending-link token. Blank makes the server generate a
# random per-process secret — fine for a single instance, but in-flight links
# break across a restart or a second replica. Set it explicitly anywhere
# horizontally scaled.
GOOGLE_LINK_SECRET=

# --- WhatsApp OTP delivery ---
# Both blank falls back to a stub sender that logs the code instead of sending
# it, so local development works without Meta credentials.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_verification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v25.0
